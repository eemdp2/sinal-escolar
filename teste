    <button onclick="testarSom('somA8')">A8</button>
    <button onclick="testarSom('somA9')">A9</button>
    <button onclick="testarSom('somFim')">Fim</button>

    <hr>

    <button onclick="testarSequencia('somA1')">🔔 + A1</button>
    <button onclick="testarSequencia('somA2')">🔔 + A2</button>
    <button onclick="testarSequencia('somA3')">🔔 + A3</button>
    <button onclick="testarSequencia('somA4')">🔔 + A4</button>
