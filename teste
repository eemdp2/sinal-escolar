</p>

<div class="proximo-toque">
    Próximo sinal:
    <span id="proxSinal">--:--</span>
</div>

<div class="testes">
    <h3>Teste dos Sons</h3>

    <button onclick="testarSom('somIntro')">🔔 Sinal</button>

    <hr>

    <button onclick="testarSom('somA1')">A1</button>
    <button onclick="testarSom('somA2')">A2</button>
    <button onclick="testarSom('somA3')">A3</button>
    <button onclick="testarSom('somA4')">A4</button>
