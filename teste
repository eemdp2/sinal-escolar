</div>

<audio id="somIntro" src="sons/sinal.mp3"></audio>

<audio id="somA1" src="sons/a1.mp3"></audio> <audio id="somA2" src="sons/a2.mp3"></audio> <audio id="somA3" src="sons/a3.mp3"></audio> <audio id="somA4" src="sons/a4.mp3"></audio> <audio id="somA5" src="sons/a5.mp3"></audio> <audio id="somA6" src="sons/a6.mp3"></audio> <audio id="somA7" src="sons/a7.mp3"></audio> <audio id="somA8" src="sons/a8.mp3"></audio> <audio id="somA9" src="sons/a9.mp3"></audio> <audio id="somFim" src="sons/fim.mp3"></audio>

<script src="script.js"></script>

<script>

function pararTodos() {

    const audios = document.querySelectorAll('audio');

    audios.forEach(audio => {
        audio.pause();
        audio.currentTime = 0;
    });

}

function testarSom(id) {

    pararTodos();

    const audio = document.getElementById(id);

    if(audio){
        audio.play();
    }

}

function testarSequencia(idAudio) {

    pararTodos();

    const intro = document.getElementById('somIntro');
    const audio = document.getElementById(idAudio);

    intro.play();

    intro.onended = () => {
        audio.play();
    };

}

if ('serviceWorker' in navigator) {

    navigator.serviceWorker.register('sw.js')
    .then(() => console.log('Service Worker Registrado!'))
    .catch(err => console.log('Erro no SW:', err));

}

</script>

</body>
